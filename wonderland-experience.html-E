  <!-- --------------------------------------------------------- 9 RANGE -->
  <section class="wx-range">
    <div class="container"><h2 class="wx-h">View the Range</h2></div>
    <div class="wx-range-row wx-bleed">
      <figure><div class="wx-ph">XTR</div><figcaption><h3>XTR</h3><p>Extreme Off-road</p></figcaption></figure>
      <figure><div class="wx-ph">Solara</div><figcaption><h3>Solara</h3><p>Composite Off-road</p></figcaption></figure>
      <figure><div class="wx-ph">Hornet</div><figcaption><h3>Hornet</h3><p>Rugged Off-road</p></figcaption></figure>
      <figure><div class="wx-ph">Amaroo</div><figcaption><h3>Amaroo</h3><p>Classic Off-road</p></figcaption></figure>
    </div>
  </section>

  <!-- ---------------------------------------------------------- 10 CTA -->
  <!-- Copied from home.html unchanged (markup, styles.css/homepage.css rules,
       budget.js; the select-chevron and pill behaviours are lifted verbatim
       into wx-contact.js). The form still posts nowhere, as on home. -->
  <section class="home-contact wx-contact" id="ready">
    <div class="container">
      <h2 class="home-contact-title"><a href="compact.html"><span class="ln">Ready for</span> <span class="ln">Adventure ?</span></a></h2>
      <p class="home-contact-lede">Our experts will guide you through your caravan <br>
        customisation. We&rsquo;ll listen to understand how you&rsquo;ll use <br>
        your van, then bring your dream to life.</p>

      <form class="home-form" action="#" method="post" autocomplete="off" novalidate>
        <div class="home-cols">

          <div class="home-col">
            <div class="field field--line">
              <input id="h-first" name="first-name" type="text" placeholder="First Name" required autocomplete="given-name">
              <span class="req" aria-hidden="true">*</span>
            </div>
            <div class="field field--line">
              <input id="h-email" name="email" type="email" placeholder="Email" required autocomplete="off">
              <span class="req" aria-hidden="true">*</span>
            </div>
            <div class="home-pair">
              <div class="field field--select">
                <select id="h-state" name="state" autocomplete="off" required>
                  <option value="" selected disabled>State</option>
                  <option>Victoria</option>
                  <option>New South Wales</option>
                  <option>Queensland</option>
                  <option>South Australia</option>
                  <option>Western Australia</option>
                  <option>Tasmania</option>
                  <option>Northern Territory</option>
                  <option>Australian Capital Territory</option>
                </select>
                <svg class="chev" viewBox="0 0 14 8" aria-hidden="true"><path d="M0 0L7 7L14 0" fill="none" stroke="currentColor"/></svg>
                <span class="req" aria-hidden="true">*</span>
              </div>
              <div class="field field--line">
                <input id="h-postcode" name="postcode" type="text" inputmode="numeric" placeholder="Post Code" required autocomplete="off">
                <span class="req" aria-hidden="true">*</span>
              </div>
            </div>

            <!-- the artboard's two checkboxes, rebuilt as the Contact page pill -->
            <fieldset class="chips home-chips">
              <legend class="sr-only">What would you like to do?</legend>
              <span class="chips-thumb is-init" aria-hidden="true"></span>
              <label class="chip">
                <input type="radio" name="enquiry-type" value="Call back" checked>
                <span>Call back</span>
              </label>
              <label class="chip">
                <input type="radio" name="enquiry-type" value="Book a factory tour">
                <span>Book a factory tour</span>
              </label>
            </fieldset>
          </div>

          <div class="home-col">
            <div class="field field--line">
              <input id="h-last" name="last-name" type="text" placeholder="Last Name" required autocomplete="off">
            </div>
            <div class="field field--line">
              <input id="h-phone" name="phone" type="tel" placeholder="Phone" required autocomplete="off">
              <span class="req" aria-hidden="true">*</span>
            </div>
            <div class="field field--area home-area">
              <label class="sr-only" for="h-message">Something you&rsquo;d like to tell us...</label>
              <textarea id="h-message" name="message" placeholder="Something you&rsquo;d like to tell us..."></textarea>
            </div>
          </div>

        </div>

        <!-- Budget. Opens for Call back and Get a Quote; see budget.js.
             The radios ship disabled so nothing is submitted from a phone,
             or without JS, where the question is never asked. -->
        <div class="budget">
          <div class="budget-shell no-anim">
            <div class="budget-inner">
              <div class="budget-head"><b>Budget</b><i class="budget-value">&mdash;</i><i class="budget-why"></i></div>
              <div class="budget-scale" role="radiogroup" aria-label="Budget">
              <div class="budget-track"><span class="budget-fill"></span></div>
              <label class="budget-stop" style="--p: 0">
                <input type="radio" name="budget" value="$120,000 &ndash; $140,000" data-why="range" data-p="0" checked disabled>
                <span>$120&ndash;140k</span>
              </label>
              <label class="budget-stop" style="--p: .33333">
                <input type="radio" name="budget" value="$140,000 &ndash; $180,000" data-why="flexible" data-p=".33333" disabled>
                <span>$140&ndash;180k</span>
              </label>
              <label class="budget-stop" style="--p: .66667">
                <input type="radio" name="budget" value="$180,000 +" data-why="willing to invest in the best spec" data-p=".66667" disabled>
                <span>$180k +</span>
              </label>
              <label class="budget-stop budget-stop--na" style="--p: 1">
                <input type="radio" name="budget" value="Not sure yet" data-p="1" data-na="1" disabled>
                <span>Not sure yet</span>
              </label>
              </div>
            </div>
          </div>
        </div>

        <button class="btn-submit" type="submit">Submit</button>
      </form>
    </div>
  </section>

</main>
