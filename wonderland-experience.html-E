          <button class="wx-dealers-arrow wx-dealers-arrow--prev" id="wxPrev" type="button" aria-label="Previous state">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor"/></svg>
          </button>
          <div class="wx-dealers-pill" id="wxBar" role="tablist" aria-label="State">
            <span class="wx-dealers-thumb" aria-hidden="true"></span>
          </div>
          <button class="wx-dealers-arrow wx-dealers-arrow--next" id="wxNext" type="button" aria-label="Next state">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor"/></svg>
          </button>
        </div>
