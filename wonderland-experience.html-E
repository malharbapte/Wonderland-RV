<!-- ================================================ THE WONDERLAND EXPERIENCE
  Filled: hero, DNA + quote, the customisation journey, the options, Legendary
  service, and the closing "Ready for adventure ?" (copied from the home page).
  Still the skeleton: section 8 (dealers) and the images of
  section 9 (the range) -- grey blocks labelled with what goes in them.
  ======================================================================= -->
<main class="wx">

  <!-- ---------------------------------------------------------- 1 HERO -->
  <section class="wx-hero wx-bleed">
    <img class="wx-hero-img" src="assets/img/experience/hero.webp" width="1920" height="755"
         alt="Four Wonderland caravans camped on a sandy lake shore at dusk">
    <div class="wx-hero-copy">
      <h1>The Wonderland Experience</h1>
      <p>Crafting your dream caravan, one detail at a time</p>
    </div>
  </section>

  <!-- ----------------------------------------------------------- 2 DNA -->
  <section class="wx-dna">
    <div class="container">
      <h2 class="wx-h">Innovation is in our DNA</h2>
      <p>Since Wonderland RV opened shop in 2014, customisation and innovation
        are at the core of what we do. Our mission remained the same over the
        years: build bespoke caravans for caravanners who know what they want.
        We are attentive to their new ideas, we encourage our suppliers to push
        the boundaries of what&rsquo;s possible, we listen to customer feedback
        and we test the caravans ourselves and always come back with a better
        way to do things.</p>
    </div>
  </section>

  <!-- --------------------------------------------------------- 3 QUOTE -->
  <!-- Built the way the home page's pull quote is: picture off the left edge
       to 59.5%, quote on the right at 61.7%, the same opening-mark outline.
       The picture is a still from the home slideshow (slide-1) for now. -->
  <section class="wx-quote wx-bleed">
    <div class="wx-quote-media">
      <img src="assets/img/home/slide-1.jpg" alt="A Wonderland caravan set up in a field of long grass" loading="lazy">
    </div>
    <blockquote class="wx-quote-copy">
      <p><svg class="qmark" viewBox="0 0 352 208" aria-hidden="true"><path d="M159 208H289L352 0H249ZM0 208H130L193 0H90Z"/></svg>Because no two travellers are <br>
        the same, we believe no two <br>
        caravans should be either.&rdquo;</p>
      <cite>Your travels, your vision, <br>
        your caravan journey, your rules.</cite>
    </blockquote>
  </section>

  <!-- ------------------------------------------------------- 4 JOURNEY -->
  <!-- Six steps; four show at a time. One press, a drag, a swipe or a
       sideways trackpad gesture each move the row; see wx-page.js. Each card
       works like a Wonderlander card on the home page: the orange band holds
       the title and grows on hover to reveal the step's paragraph. The
       chevrons between the cards are part of the track, so they travel with
       the cards. -->
  <section class="wx-journey wx-bleed" aria-roledescription="carousel" aria-label="Your Wonderland customisation journey">
    <h2 class="wx-h">Your Wonderland<br>customisation journey</h2>
    <div class="wx-journey-stage">
      <button class="wx-journey-arrow wx-journey-arrow--prev" type="button" aria-label="Previous steps"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      <div class="wx-journey-viewport">
        <div class="wx-journey-track" id="wxJourneyTrack">
        <article class="wx-journey-card" tabindex="0">
          <div class="wx-card-media"><img src="assets/img/experience/step-1.webp" alt="A Wonderland caravan being towed along a country road" loading="lazy" draggable="false"></div>
          <div class="wx-card-band">
            <h3 class="wx-card-title">Your dream vision</h3>
            <div class="wx-card-bio-wrap"><div class="wx-card-bio-inner">
              <p class="wx-card-bio">Envision your dream caravan. What kind of trips would you take? How many companions will travel with you? What features and amenities are essential for your comfort? Get inspired by fellow Wonderlanders, caravan shows, and ideas shared on social&nbsp;media.</p>
            </div></div>
          </div>
        </article>
        <span class="wx-journey-chev" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        <article class="wx-journey-card" tabindex="0">
          <div class="wx-card-media"><img src="assets/img/experience/step-2.jpg" alt="A queen bed made up with cushions and a throw" loading="lazy" draggable="false"></div>
          <div class="wx-card-band">
            <h3 class="wx-card-title">The fundamental decisions</h3>
            <div class="wx-card-bio-wrap"><div class="wx-card-bio-inner">
              <p class="wx-card-bio">Select the model that best matches your needs and preferences, and chose from over 60 pre-defined layouts for couples and family configurations. Add your specifications, length, chassis, suspension, wheels, insulation, and&nbsp;more.</p>
            </div></div>
          </div>
        </article>
        <span class="wx-journey-chev" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        <article class="wx-journey-card" tabindex="0">
          <div class="wx-card-media"><img src="assets/img/experience/step-3.webp" alt="A kitchen sink with a gold tap beneath a window" loading="lazy" draggable="false"></div>
          <div class="wx-card-band">
            <h3 class="wx-card-title">Make it your own</h3>
            <div class="wx-card-bio-wrap"><div class="wx-card-bio-inner">
              <p class="wx-card-bio">Personalise your caravan with a wide range of upgrades. Choose from electrical system, to cladding, privacy options and appliances. You can also select your preferred interior finishes, fabrics, and colours. We&rsquo;re excited to create a space that&rsquo;s truly your&nbsp;own!</p>
            </div></div>
          </div>
        </article>
        <span class="wx-journey-chev" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        <article class="wx-journey-card" tabindex="0">
          <div class="wx-card-media"><img src="assets/img/experience/step-4.jpg" alt="A dinette seat with a bowl of fruit on the table" loading="lazy" draggable="false"></div>
          <div class="wx-card-band">
            <h3 class="wx-card-title">Designing your caravan</h3>
            <div class="wx-card-bio-wrap"><div class="wx-card-bio-inner">
              <p class="wx-card-bio">Our creative team will take your inputs to come up with the perfect van design. They&rsquo;ll prepare floor plans and elevations, and make sure all your requests work perfectly together so there isn&rsquo;t any surprises at a later&nbsp;stage.</p>
            </div></div>
          </div>
        </article>
        <span class="wx-journey-chev" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        <article class="wx-journey-card" tabindex="0">
          <div class="wx-card-media"><img src="assets/img/experience/step-5.webp" alt="The underside of a Wonderland chassis in the factory" loading="lazy" draggable="false"></div>
          <div class="wx-card-band">
            <h3 class="wx-card-title">Watch your van coming to life</h3>
            <div class="wx-card-bio-wrap"><div class="wx-card-bio-inner">
              <p class="wx-card-bio">Our unmatched craftsmanship uses a unique jigsaw wall construction method for strength, durability, and precision. We build only with premium materials from reputable suppliers. Watch your van come to life with progress updates and&nbsp;images!</p>
            </div></div>
          </div>
        </article>
        <span class="wx-journey-chev" aria-hidden="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        <article class="wx-journey-card" tabindex="0">
          <div class="wx-card-media"><img src="assets/img/experience/step-6.jpg" alt="An aerial view of a caravan on a dirt road through bushland" loading="lazy" draggable="false"></div>
          <div class="wx-card-band">
            <h3 class="wx-card-title">Your travel journey begins here</h3>
            <div class="wx-card-bio-wrap"><div class="wx-card-bio-inner">
              <p class="wx-card-bio">After a thorough inspection, we will hand over the keys to your new caravan. In our comprehensive handover session, we will explain how to use and maintain it. It will come with a 3-year factory-backed warranty and premium after-sales service for your peace of mind and&nbsp;satisfaction.</p>
            </div></div>
          </div>
        </article>
        </div>
      </div>
      <button class="wx-journey-arrow wx-journey-arrow--next" type="button" aria-label="Next steps"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    </div>
  </section>

  <!-- ------------------------------------------------------- 5 OPTIONS -->
  <!-- A tab list: choosing an option shows its picture, heading and copy on
       the right. All six panels share one grid cell, so the section keeps the
       height of the tallest and nothing below it moves when you switch. -->
  <section class="wx-options">
    <div class="container">
      <h2 class="wx-h">The customisation options</h2>
      <div class="wx-options-grid">
        <div class="wx-options-list" role="tablist" aria-orientation="vertical" aria-label="Customisation options">
          <button class="wx-opt is-on" type="button" role="tab" id="wxo-layout" aria-controls="wxp-layout" aria-selected="true" tabindex="0"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Layout</span></button>
          <button class="wx-opt" type="button" role="tab" id="wxo-chassis" aria-controls="wxp-chassis" aria-selected="false" tabindex="-1"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Chassis</span></button>
          <button class="wx-opt" type="button" role="tab" id="wxo-electrical" aria-controls="wxp-electrical" aria-selected="false" tabindex="-1"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Electrical</span></button>
          <button class="wx-opt" type="button" role="tab" id="wxo-internal" aria-controls="wxp-internal" aria-selected="false" tabindex="-1"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Internal Plan &amp; Colours</span></button>
          <button class="wx-opt" type="button" role="tab" id="wxo-plumbing" aria-controls="wxp-plumbing" aria-selected="false" tabindex="-1"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Plumbing &amp; Appliances</span></button>
          <button class="wx-opt" type="button" role="tab" id="wxo-external" aria-controls="wxp-external" aria-selected="false" tabindex="-1"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg><span>External Plan</span></button>
        </div>
        <div class="wx-options-media">
          <div class="wx-opt-panel is-on" role="tabpanel" id="wxp-layout" aria-labelledby="wxo-layout" data-opt="layout">
            <img src="assets/img/experience/opt-layout.jpg" alt="Dinette and queen bed inside a Wonderland caravan" loading="lazy">
            <h3>Layout</h3>
            <p>Select your desired caravan length, bed configuration, storage solutions, and seating arrangements, whether you are a couple or a family with kids.</p>
          </div>
          <div class="wx-opt-panel" role="tabpanel" id="wxp-chassis" aria-labelledby="wxo-chassis" data-opt="chassis">
            <img src="assets/img/experience/opt-chassis.jpg" alt="The underside of a caravan showing suspension and all-terrain tyres" loading="lazy">
            <h3>Chassis</h3>
            <p>Pick your suspension and brakes, chassis finish, hitch, jockey wheel, stone guard, plus your choice of water tank, tunnel boot, and more.</p>
          </div>
          <div class="wx-opt-panel" role="tabpanel" id="wxp-electrical" aria-labelledby="wxo-electrical" data-opt="electrical">
            <img src="assets/img/experience/opt-electrical.jpg" alt="Battery and power monitoring screens" loading="lazy">
            <h3>Electrical</h3>
            <p>Tech, luxury and convenience are the goals of our offgrid electrical systems. Enjoy air conditioning, audio-visual media, connectivity, GPS, anti-theft tracking, lighting, and enough power for all the appliances you want to run to enhance your journey.</p>
          </div>
          <div class="wx-opt-panel" role="tabpanel" id="wxp-internal" aria-labelledby="wxo-internal" data-opt="internal">
            <img src="assets/img/experience/opt-internal.jpg" alt="Looking through the kitchen towards the bed of a Wonderland caravan" loading="lazy">
            <h3>Internal Plan &amp; Colours</h3>
            <p>Personalise your caravan space in order for it to be aesthetically pleasing to you by choosing from different colour themes of bathroom accessories, cupboard colours, handles, upholstery, flooring &ndash; plus decals and cladding colour for your exterior.</p>
          </div>
          <div class="wx-opt-panel" role="tabpanel" id="wxp-plumbing" aria-labelledby="wxo-plumbing" data-opt="plumbing">
            <img src="assets/img/experience/opt-plumbing.jpg" alt="A caravan bathroom with a black vessel basin and tap" loading="lazy">
            <h3>Plumbing &amp; Appliances</h3>
            <p>Focus on functionality and comfort when you choose plumbing and appliance features for your home on wheels, like a heater, BBQ bayonet, fridge, hot water service, kitchen sink, and toilet.</p>
          </div>
          <div class="wx-opt-panel" role="tabpanel" id="wxp-external" aria-labelledby="wxo-external" data-opt="external">
            <img src="assets/img/experience/opt-external.jpg" alt="A slide-out BBQ and bike rack on a Wonderland caravan" loading="lazy">
            <h3>External Plan</h3>
            <p>Customise your caravan&rsquo;s external features &ndash; choose key options like entry door size, external kitchen, bike rack and a convenient picnic table &ndash; to suit your outdoor adventures and personal lifestyle.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------- 6 SERVICE -->
  <!-- Copied from home.html unchanged: same markup, same styles.css rules,
       same reviews.js. -->
  <section class="service wx-service">
    <div class="container service-head">
      <h2 class="service-title">LEGENDARY SERVICE</h2>
      <p class="service-kicker">OUR HAPPY CUSTOMERS</p>
    </div>

    <div class="service-band">
      <div class="service-viewport">
        <div class="service-track" id="serviceTrack">
      <div class="service-slide">
        <div class="service-media ph" data-ph="assets/img/home/review-julian.jpg">
          <img src="assets/img/home/review-julian.jpg" alt="Inside a Wonderland RV: kitchen, dinette and queen bed"
               onload="this.parentElement.classList.remove('ph')" onerror="this.remove()">
        </div>
        <blockquote class="service-quote">
          <p><svg class="qmark" viewBox="0 0 352 208" aria-hidden="true"><path d="M159 208H289L352 0H249ZM0 208H130L193 0H90Z"/></svg>The quality, craftsmanship, and attention to detail are absolutely outstanding you can really see the pride that&rsquo;s gone into this build.&rdquo;</p>
          <span class="service-name">JULIAN RANDALL</span>
          <span class="service-role">WONDERLANDER</span>
        </blockquote>
      </div>
      <div class="service-slide">
        <div class="service-media ph" data-ph="assets/img/home/review-jasique.jpg">
          <img src="assets/img/home/review-jasique.jpg" alt="The caf&eacute; dinette inside a Wonderland RV"
               onload="this.parentElement.classList.remove('ph')" onerror="this.remove()">
        </div>
        <blockquote class="service-quote">
          <p><svg class="qmark" viewBox="0 0 352 208" aria-hidden="true"><path d="M159 208H289L352 0H249ZM0 208H130L193 0H90Z"/></svg>Our Wonderland Amaroo has truly lived up to its reputation and exceeded our expectations while we&rsquo;ve explored Australia as a family.&rdquo;</p>
          <span class="service-name">JASIQUE</span>
          <span class="service-role">WONDERLANDER</span>
        </blockquote>
      </div>
      <div class="service-slide">
        <div class="service-media ph" data-ph="assets/img/home/review-mandi.jpg">
          <img src="assets/img/home/review-mandi.jpg" alt="Queen bed and dinette inside a Wonderland RV"
               onload="this.parentElement.classList.remove('ph')" onerror="this.remove()">
        </div>
        <blockquote class="service-quote">
          <p><svg class="qmark" viewBox="0 0 352 208" aria-hidden="true"><path d="M159 208H289L352 0H249ZM0 208H130L193 0H90Z"/></svg>Our van is the ultimate family caravan and the finishes are absolute premium quality. We love hitting the road with our van any chance we get.&rdquo;</p>
          <span class="service-name">MANDI DAVIES</span>
          <span class="service-role">WONDERLANDER</span>
        </blockquote>
      </div>
      <div class="service-slide">
        <div class="service-media ph" data-ph="assets/img/home/review-sandro.jpg">
          <img src="assets/img/home/review-sandro.jpg" alt="The queen bed at the front of a Wonderland RV"
               onload="this.parentElement.classList.remove('ph')" onerror="this.remove()">
        </div>
        <blockquote class="service-quote">
          <p><svg class="qmark" viewBox="0 0 352 208" aria-hidden="true"><path d="M159 208H289L352 0H249ZM0 208H130L193 0H90Z"/></svg>The attention to detail and build quality is exceptional to say the least. This is our 5th caravan and I am sure we will be going back to Wonderland for our 6th.&rdquo;</p>
          <span class="service-name">SANDRO CARBONI</span>
          <span class="service-role">WONDERLANDER</span>
        </blockquote>
      </div>
      </div>
      </div>

      <button class="service-arrow service-arrow--prev" type="button" aria-label="Previous review">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <button class="service-arrow service-arrow--next" type="button" aria-label="Next review">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
  </section>

  <!-- -------------------------------------------------------- 7 MAKERS -->
  <!-- Copy is verbatim from wonderlandrv.com.au. Photos are blank on purpose
       (none exist yet); the squares stay grey until they do. Each card opens
       on hover like the journey cards. -->
  <section class="wx-makers">
    <div class="container">
      <h2 class="wx-h">Our dream makers</h2>
      <p class="wx-makers-intro">Each of our roles at Wonderland RV is essential to building your caravan. At the heart of it all is helping you fulfill your caravan&nbsp;dreams.</p>
    </div>
    <div class="wx-makers-row wx-bleed">
      <figure class="wx-mk" tabindex="0">
        <div class="wx-mk-photo"></div>
        <div class="wx-mk-band">
          <h3 class="wx-mk-name">Customer Relations Team</h3>
          <div class="wx-mk-wrap"><div class="wx-mk-inner"><p class="wx-mk-text">Making dream caravans a reality means learning about your unique story. We listen, guide, and support you so we can ensure a delightful Wonderland experience. We nurture relationships with Wonderlanders even after they drive off into their&nbsp;adventures.</p></div></div>
        </div>
      </figure>
      <figure class="wx-mk" tabindex="0">
        <div class="wx-mk-photo"></div>
        <div class="wx-mk-band">
          <h3 class="wx-mk-name">Design &amp; Innovation Team</h3>
          <div class="wx-mk-wrap"><div class="wx-mk-inner"><p class="wx-mk-text">We are responsible for translating your ideas into a design. We are behind the innovative and custom features that go into your caravan. Together, we will refine your layout, and improve the appearance and&nbsp;functionality.</p></div></div>
        </div>
      </figure>
      <figure class="wx-mk" tabindex="0">
        <div class="wx-mk-photo"></div>
        <div class="wx-mk-band">
          <h3 class="wx-mk-name">Manufacturing Team</h3>
          <div class="wx-mk-wrap"><div class="wx-mk-inner"><p class="wx-mk-text">Our role is to build your caravan exactly as ordered, with precision and care. From setting up the sturdy chassis to finalising the fit out, our skilled team work tirelessly to create a one-of-a-kind masterpiece. We meticulously transform the raw materials into seamless cabinetry, cutting edge electrical systems, and everything else that you will love in your&nbsp;caravan.</p></div></div>
        </div>
      </figure>
      <figure class="wx-mk" tabindex="0">
        <div class="wx-mk-photo"></div>
        <div class="wx-mk-band">
          <h3 class="wx-mk-name">Marketing &amp; Events Team</h3>
          <div class="wx-mk-wrap"><div class="wx-mk-inner"><p class="wx-mk-text">Marketing at Wonderland RV goes beyond showcasing why our caravans are trusted, tough and built to last. It&rsquo;s about bringing the Wonderland lifestyle to life and welcoming our customers into what it truly means to be a Wonderlander. We&rsquo;re proud of our strong, close-knit owner community and love creating opportunities for connection through owner meet-and-greets, events and experiences designed to bring our customers&nbsp;together.</p></div></div>
        </div>
      </figure>
    </div>
  </section>

  <!-- ------------------------------------------------------- 8 DEALERS -->
  <section class="wx-dealers">
    <div class="container"><h2 class="wx-h">Meet our extended team<br>across the country</h2></div>
    <!-- Dealer details are the ones on wonderlandrv.com.au/dealers. Pick a state on
         the map or in the bar; the panel on the right follows (wx-dealers.js). -->
    <div class="wx-dealers-row wx-bleed">
      <div class="wx-dealers-map">
        <!-- THE STATE BAR: every state is named; choose one here or on the map.
             Arrows step to the previous and next state. -->
