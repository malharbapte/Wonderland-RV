<!doctype html>
<html lang="en-AU"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sample: event details colours</title>
<link rel="stylesheet" href="assets/css/styles.css?v=329">
<link rel="stylesheet" href="assets/css/events-popup.css?v=5">
<style>
body{margin:0;background:#fff}
/* B: the label and the bold line swap colours */
[data-o="b"] .evp-row small{color:var(--ink)}
[data-o="b"] .evp-row b{color:var(--orange-deep)}
[data-o="b"] .evp-find span{color:var(--orange-deep)}
</style></head><body>
<div style="padding:1rem 3rem"><h1 style="font-family:var(--aviano)">Events page (placeholder)</h1></div>
<a href="#" id="go" style="position:absolute;left:-999px">Events</a>
<script src="assets/js/events-popup.js?v=6"></script>
<script>
function o(){document.documentElement.dataset.o=(location.hash||'#a').slice(1)}
window.addEventListener('hashchange',o);o();
setTimeout(function(){document.getElementById('go').click()},50);
</script>
</body></html>
