<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sample: event details as lines</title>
<style>
body{margin:0;padding:0 20px 30px;background:#eceae6;font:14px/1.45 system-ui,sans-serif;color:#111}
.bar{position:sticky;top:0;z-index:9;background:#eceae6;padding:14px 0;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
.bar b{font-size:16px;margin-right:6px}.bar a{padding:6px 14px;border:1px solid #999;border-radius:4px;color:#111;text-decoration:none;background:#fff}
.bar a.on{background:#111;color:#fff;border-color:#111}.note{margin:0 0 16px;color:#555;max-width:980px}
.row{display:flex;gap:28px;flex-wrap:wrap;align-items:flex-start}.cap{margin:0 0 8px;font-weight:700}
.dk{width:960px;height:700px;overflow:hidden;border:8px solid #111;border-radius:8px;background:#fff;position:relative;box-sizing:content-box}
.dk iframe{width:1920px;height:1400px;border:0;transform:scale(.5);transform-origin:0 0;position:absolute;left:0;top:0}
.ph iframe{display:block;width:390px;height:780px;border:8px solid #111;border-radius:34px;background:#fff}
</style></head><body>
<div class="bar"><b>When / Where / Find us as lines</b><a href="#a" data-o="a">A &middot; grey lines (current colour)</a><a href="#b" data-o="b">B &middot; orange lines</a></div>
<p class="note" id="d"></p>
<div class="row">
<div><p class="cap">Desktop (1920 wide, shown at half size)</p><div class="dk"><iframe id="fd" src="sample-events-lines-frame.html?v=2#a" title="Desktop"></iframe></div></div>
<div class="ph"><p class="cap">iPhone (390 wide)</p><iframe id="fp" src="sample-events-lines-frame.html?v=2#a" title="Phone"></iframe></div>
</div>
<script>
(function(){var D={a:'A: the box is gone; thin grey lines (the colour the dividers have now) separate When, Where and Find us.',
b:'B: the box is gone; the same thin lines in brand orange.'};
function go(){var o=(location.hash||'#a').slice(1);if(!D[o])o='a';
[].forEach.call(document.querySelectorAll('.bar a'),function(a){a.classList.toggle('on',a.dataset.o===o)});
document.getElementById('d').textContent=D[o];
['fd','fp'].forEach(function(id){var f=document.getElementById(id);try{if(f.contentWindow.location.href!=='about:blank')f.contentWindow.location.hash=o}catch(e){}})}
window.addEventListener('hashchange',go);
['fd','fp'].forEach(function(id){document.getElementById(id).addEventListener('load',go)});go();})();
</script></body></html>
